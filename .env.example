# Claude (Anthropic API or any Anthropic-compatible gateway)
ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://your-gateway.example   # leave unset for api.anthropic.com
CLAUDE_MODEL=claude-haiku-5-5

# Admin dashboard password (use a long random string)
ADMIN_TOKEN=change-me

# Optional: where "talk to a human" requests are sent (e.g. the n8n lead agent webhook)
LEAD_WEBHOOK_URL=http://host.docker.internal:5678/webhook/lead

BUSINESS_NAME=Lumina Dental Studio
POSTGRES_PASSWORD=change-me-too
